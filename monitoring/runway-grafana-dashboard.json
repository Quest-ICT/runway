{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "The Prometheus data source scraping Runway's /actuator/prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "Runway",
  "uid": "runway-overview",
  "tags": ["runway"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "site",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(runway_http_server_requests_seconds_count, site)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Sites",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [ { "expr": "runway_sites", "refId": "A" } ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Suspended sites",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "runway_sites_suspended", "refId": "A" } ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Sites in maintenance",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [ { "expr": "runway_sites_maintenance", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Plugins loaded",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [ { "expr": "runway_plugins_loaded", "refId": "A" } ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Log lines dropped",
      "datasource": "${datasource}",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [ { "expr": "runway_logs_dropped", "refId": "A" } ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Request rate by site (req/s)",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (site) (rate(runway_http_server_requests_seconds_count{site=~\"$site\"}[5m]))",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Server-error (5xx) rate by site",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum by (site) (rate(runway_http_server_requests_seconds_count{outcome=\"server_error\",site=~\"$site\"}[5m]))",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Average request latency by site",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "sum by (site) (rate(runway_http_server_requests_seconds_sum{site=~\"$site\"}[5m])) / clamp_min(sum by (site) (rate(runway_http_server_requests_seconds_count{site=~\"$site\"}[5m])), 1e-9)",
          "legendFormat": "{{site}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "JVM heap used",
      "datasource": "${datasource}",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max", "refId": "B" }
      ]
    }
  ]
}
