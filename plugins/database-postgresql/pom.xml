<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      The PostgreSQL provider for the database plugin: the pgjdbc driver (BSD-2-Clause) in lib/ and the code that
      builds its DataSource. Same managed versions as the Runway kernel (Spring Boot 4.0.6), thin jar, no repackage.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>mx.quest</groupId>
    <artifactId>runway-plugin-database-postgresql</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>Runway Database — PostgreSQL</name>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0, with the Runway additional permission for plugins</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>See LICENSE and LICENSE-EXCEPTION.</comments>
        </license>
    </licenses>
    <description>
        The PostgreSQL provider for the Runway database plugin: bundles the pgjdbc driver and builds a configured, unpooled DataSource (one host, pinned TLS and timeouts). Every statement Runway runs is written in the database plugin.
    </description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds: pins every archive entry's timestamp. Bump at each release. -->
        <project.build.outputTimestamp>2026-10-29T00:00:00Z</project.build.outputTimestamp>
        <!-- The runway-spi this plugin compiles against: SPI 1.1.0 adds PluginSettings.appSecret. -->
        <runway.version>1.1.0</runway.version>
        <!-- The database plugin whose SPI this provider implements (provided: the shared plugin class loader
             supplies it; install ../database first). -->
        <database.version>1.0.0</database.version>
        <!-- The driver bundled in lib/. Pinned so the bundle never drifts from what the notices name. -->
        <postgresql.version>42.7.10</postgresql.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>mx.quest</groupId>
            <artifactId>runway-spi</artifactId>
            <version>${runway.version}</version>
        </dependency>
        <dependency>
            <groupId>mx.quest</groupId>
            <artifactId>runway-spi-testkit</artifactId>
            <version>${runway.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>mx.quest</groupId>
            <artifactId>runway-plugin-database</artifactId>
            <version>${database.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The driver, bundled into lib/ by the assembly below. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- The kernel supplies these at runtime; never bundled. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>runway-plugin-database-postgresql</finalName>
        <plugins>
            <!-- 1. The driver into target/staged-lib, with its versioned file name; the assembly copies it into lib/. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bundle-libs</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.postgresql</groupId>
                                    <artifactId>postgresql</artifactId>
                                    <version>${postgresql.version}</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/staged-lib</outputDirectory>
                            <stripVersion>false</stripVersion>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- 2. Assemble target/database/ (folder) and the UI zip. -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assemble-plugin-folder</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="stage" value="${project.build.directory}/database-postgresql"/>
                                <delete dir="${stage}"/>
                                <mkdir dir="${stage}"/>
                                <copy file="${project.basedir}/plugin.yml" todir="${stage}"/>
                                <copy file="${project.basedir}/LICENSE" todir="${stage}"/>
                                <copy file="${project.basedir}/LICENSE-EXCEPTION" todir="${stage}"/>
                                <copy file="${project.basedir}/THIRD-PARTY-NOTICES" todir="${stage}"/>
                                <copy file="${project.build.directory}/runway-plugin-database-postgresql.jar" todir="${stage}"/>
                                <copy todir="${stage}/lib">
                                    <fileset dir="${project.build.directory}/staged-lib"/>
                                </copy>
                                <!-- Never a plugin zip without its libraries (it would load and fail at its first use). -->
                                <fail message="no library in ${stage}/lib">
                                    <condition><resourcecount when="equal" count="0">
                                        <fileset dir="${stage}" includes="lib/*.jar"/></resourcecount></condition>
                                </fail>
                                <touch datetime="${project.build.outputTimestamp}"
                                       pattern="yyyy-MM-dd'T'HH:mm:ss'Z'">
                                    <fileset dir="${stage}"/>
                                    <dirset dir="${stage}"/>
                                    <dirset dir="${project.build.directory}" includes="database-postgresql"/>
                                </touch>
                                <!-- The stamped files predate any earlier zip, so <zip> would skip the rebuild. -->
                                <delete file="${project.build.directory}/runway-plugin-database-postgresql-${project.version}.zip"/>
                                <zip destfile="${project.build.directory}/runway-plugin-database-postgresql-${project.version}.zip">
                                    <zipfileset dir="${project.build.directory}" includes="database-postgresql/**"/>
                                </zip>
                                <echo message="Staged install folder (with the driver in lib/): ${stage}"/>
                                <echo message="UI-uploadable archive: ${project.build.directory}/runway-plugin-database-postgresql-${project.version}.zip"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
