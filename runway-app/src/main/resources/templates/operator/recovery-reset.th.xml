<?xml version="1.0" encoding="UTF-8"?>
<!-- Reset-password page, shared by both realms. `valid` toggles between the new-password form and the
     invalid/expired notice; `error` (a message-key suffix) shows a form error; `username` names the account. -->
<thlogic>
    <!-- The page language follows the operator locale in force, so a screen reader pronounces it correctly. -->
    <attr sel="html" th:lang="${#locale.toLanguageTag()}"/>
    <attr sel="#rc-title" th:text="#{op.recovery.reset.title}"/>
    <attr sel="#rc-body" th:classappend="${accentBorder}" th:attr="data-i18n-pw-toggle=#{op.a11y.pwToggle}"/>
    <attr sel="#rc-brand" th:text="${brand}"/>

    <attr sel="#rc-reset-wrap" th:if="${valid}"/>
    <attr sel="#rc-reset-heading" th:text="#{op.recovery.reset.heading}"/>
    <attr sel="#rc-reset-lead" th:if="${username != null}"/>
    <attr sel="#rc-username" th:text="${username}"/>
    <attr sel="#rc-error" th:if="${error != null}" th:text="#{'op.recovery.reset.err.' + ${error}}"/>
    <attr sel="#rc-form" th:action="${postUrl}"/>
    <attr sel="#rc-csrf"
          th:attr="name=${_csrf != null ? _csrf.parameterName : '_csrf'},value=${_csrf != null ? _csrf.token : ''}"/>
    <attr sel="#rc-token" th:value="${token}"/>
    <attr sel="#rc-pass-label" th:text="#{op.recovery.reset.password}"/>
    <attr sel="#rc-confirm-label" th:text="#{op.recovery.reset.confirm}"/>
    <attr sel="#rc-reset-submit" th:text="#{op.recovery.reset.submit}" th:classappend="${accentBtn}"/>

    <attr sel="#rc-invalid-wrap" th:if="${!valid}"/>
    <attr sel="#rc-invalid-heading" th:text="#{op.recovery.reset.invalid.heading}"/>
    <attr sel="#rc-invalid-text" th:text="#{op.recovery.reset.invalid.text}"/>

    <attr sel="#rc-back" th:href="${loginUrl}" th:text="#{op.recovery.back}"/>

    <!-- Language switcher: shown only with 2+ offered languages. The return path carries the reset token (when the
         link is valid) so switching language keeps it; the active language is bold. -->
    <attr sel="#rc-langswitch" th:if="${operatorLanguages != null and operatorLanguages.size() gt 1}"/>
    <attr sel="#rc-langswitch/a" th:each="l : ${operatorLanguages}"
          th:attr="href=@{/__ui-lang(lang=${l},to=${token != null ? postUrl + '?token=' + token : currentPath})},aria-current=${l == uiLocale ? 'true' : null}"
          th:text="#{'op.lang.' + ${l}}"
          th:classappend="${l == uiLocale} ? 'fw-bold' : 'text-secondary'"/>
    <!-- CSP nonce: stamp the per-request nonce on every script tag (src scripts use th:src, so this th:attr never clashes); cspNonce is "" when CSP is OFF. -->
    <attr sel="script" th:attr="nonce=${cspNonce}"/>
    <!-- Every /__assets reference carries ?v=<assetVersion> (AssetVersion): a versioned asset is cached for a
         day, so a new release must change the URL or browsers keep the old file. Scripts use th:src (never
         th:attr), so the nonce th:attr on `script` never clashes. the screen guard (OperatorA11yGuardTest) fails on a miss. -->
    <attr sel="#as-favicon" th:attr="href='/__assets/runway.svg?v=' + ${assetVersion}"/>
    <attr sel="#as-tabler-css" th:attr="href='/__assets/vendor/tabler.min.css?v=' + ${assetVersion}"/>
    <attr sel="#as-fa-css" th:attr="href='/__assets/vendor/fontawesome/css/all.min.css?v=' + ${assetVersion}"/>
    <attr sel="#as-chrome-css" th:attr="href='/__assets/runway-chrome.css?v=' + ${assetVersion}"/>
    <attr sel="#as-logo" th:src="'/__assets/runway.svg?v=' + ${assetVersion}"/>
    <attr sel="#as-tabler-js" th:src="'/__assets/vendor/tabler.min.js?v=' + ${assetVersion}"/>
    <attr sel="#as-chrome-js" th:src="'/__assets/runway-chrome.js?v=' + ${assetVersion}"/>
</thlogic>
