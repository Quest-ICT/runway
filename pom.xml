<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>mx.quest</groupId>
    <artifactId>runway</artifactId>
    <version>1.2.0</version>
    <packaging>pom</packaging>

    <name>Runway</name>
    <description>Multi-site web platform built as a kernel plus plugins</description>
    <organization>
        <name>Quest ICT SAS de CV</name>
        <url>https://quest.mx</url>
    </organization>
    <licenses>
        <license>
            <name>GNU Affero General Public License v3.0, with the Runway additional permission for plugins</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
            <distribution>repo</distribution>
            <comments>See LICENSE and LICENSE-EXCEPTION.</comments>
        </license>
    </licenses>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Reproducible builds: pins archive entry timestamps so two builds of the same source produce
             byte-identical artifacts. maven-assembly-plugin honours this for the dist zip; the .bin's
             tar+gzip is pinned separately in scripts/make-selfextract.sh. Bump at each release (two releases
             on one day need DIFFERENT values: build.time is the console asset cache-buster).
             The timestamp alone is not enough across machines: Spring Boot's repackage writes each entry's
             extended timestamp through the build JVM's default time zone, so the same source built in CST and
             in UTC differed by exactly 6 h inside the exec jar (found 2026-10-17 on a second host).
             .mvn/jvm.config pins -Duser.timezone=UTC for the Maven JVM, which removes the host's zone. -->
        <project.build.outputTimestamp>2026-10-30T17:20:00Z</project.build.outputTimestamp>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- runway-spi and runway-spi-testkit attach a sources jar (release assets for third-party plugin authors,
             docs/PLUGIN-DEVELOPMENT.md §3). Boot's parent manages 3.3.1; 3.4.0 is the version the build hosts'
             repositories already hold, so an offline build (`mvn -o`) resolves it. Both honour
             project.build.outputTimestamp, so the sources jar is byte-reproducible like the main jar. -->
        <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    </properties>

    <!--
        Reactor modules:
        - runway-spi : the dependency-free extension API (interfaces + immutable
                        model records). Plugins compile against this, never the app.
        - runway-spi-testkit : in-memory fakes of the SPI service tier, for plugin
                        unit tests (test scope). Published with runway-spi.
        - runway-app : the Spring Boot kernel (Jetty), which collects SPI
                        implementations and plugin contributions.
        Plugins live in their OWN repositories (runway-plugin-*).
    -->
    <modules>
        <module>runway-spi</module>
        <module>runway-spi-testkit</module>
        <module>runway-app</module>
        <module>runway-plugin-protection</module>
        <module>runway-dist</module>
    </modules>
</project>
